# Library root on holly (must exist; contains cd/ and dvd/ subdirs with hard links)
LIBRARY_PATH=/data2/datastore/library

# Static IPs on the staticnet Docker network
SAMBA_IP=192.168.0.230
PLEX_IP=192.168.0.231

# Samba service account name and UID (password goes in holly.secrets.prod, not here)
SAMBA_USER=discripper
SAMBA_UID=1001

# SMB protocol minimum. Default: SMB2 with modern authentication only.
# Set to true only if Sonos hardware cannot connect (older S1 devices needing SMB1).
# See DEPLOYMENT.md section 5.5 for guidance.
SAMBA_ALLOW_SMB1=false

# Samba identity — sets the NetBIOS workgroup and hostname.
# Distinct from dev (DISCRIPPERDEV / discripperdev) so the two can't be confused
# in Windows/macOS network discovery.
SAMBA_WORKGROUP=DISCRIPPER
SAMBA_HOSTNAME=discripper

# Plex config and transcode directories on holly's SSD.
# Keep separate from dev (/data3/projects/ripperdev/) so the two databases never mix.
# PLEX_CONFIG_PATH must exist before the first start (create it manually).
# PLEX_TRANSCODE_PATH is created automatically by holly.sh if absent.
PLEX_CONFIG_PATH=/data3/projects/ripper/config
PLEX_TRANSCODE_PATH=/data3/projects/ripper/transcode

# Plex server display name — set via the Plex web UI on first start.
# Documented here as a reminder; not consumed by holly.sh.
PLEX_NAME=DiscRipper

# Plex claim token — get one at https://www.plex.tv/claim/ just before the
# first start (single-use, expires in ~4 minutes). Leave blank for subsequent
# starts; the container ignores it once the server is already registered.
PLEX_CLAIM=

# Networks allowed to access Plex without authentication (comma-separated CIDR).
# Required for the Xbox app (and other LAN clients) to reach the server.
PLEX_ALLOWED_NETWORKS=192.168.0.0/24

# Timezone
TZ=Europe/London
