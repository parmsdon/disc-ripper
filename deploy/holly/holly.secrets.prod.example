# Samba service account password.
# This file must NOT be committed (it is gitignored).
# After copying, restrict permissions so only root (or the Docker-running user) can read it:
#   chmod 600 deploy/holly/holly.secrets.prod
#
# The variable name must be ACCOUNT_<username> where <username> matches
# SAMBA_USER in holly.env.prod (default: discripper). If you change SAMBA_USER,
# rename the variable here too.
ACCOUNT_discripper=changeme
