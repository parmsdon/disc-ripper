[Unit]
Description=Discripper Ripper Service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/datastore

[Service]
Type=simple
User=ripper
WorkingDirectory=/projects/ripper
Environment=DISCRIPPER_ENV=prod
ExecStart=/projects/ripper/venv/bin/python3 -m ripper_service.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
