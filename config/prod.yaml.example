# Disc Ripper - Production environment configuration
# Copy this file to config/prod.yaml and fill in real values.
# config/prod.yaml is gitignored - never commit real credentials.

environment: prod

database:
  host: "192.168.0.23"      # app/DB machine IP
  port: 5432
  name: "discripper"
  user: "discripper"
  password: "changeme"

storage:
  # NFS mount root for the prod environment (mounted on both machines)
  datastore_root: "/mnt/datastore"
  dvd_store: "dvd_store"
  cd_store: "cd_store"
  raw_subfolder: "raw"
  # Local scratch space on the RIPPER machine (not used on app/DB machine).
  # Use /var/tmp (survives reboots) and a prod-specific name — dev and prod
  # share the ripper host (rimmer) and must not share a scratch directory.
  scratch_dir: "/var/tmp/discripper_scratch_prod"

# Drive mappings - only relevant on the ripper machine (rimmer).
# On the app/DB machine (ripper), leave this as an empty list.
drives: []
# Example drive entries for the ripper machine (uncomment and edit):
# drives:
#   - device: "/dev/sr_drv02"
#     label: "Drive 2"
#     active: true
#   - device: "/dev/sr_drv03"
#     label: "Drive 3"
#     active: true
#   - device: "/dev/sr_drv04"
#     label: "Drive 4"
#     active: true
#   - device: "/dev/sr_drv05"
#     label: "Drive 5"
#     active: true
#   - device: "/dev/sr_drv06"
#     label: "Drive 6"
#     active: true
#   - device: "/dev/sr_drv07"
#     label: "Drive 7"
#     active: true
#   - device: "/dev/sr_drv08"
#     label: "Drive 8"
#     active: true
#   - device: "/dev/sr_drv09"
#     label: "Drive 9"
#     active: true

# Flask API settings (gunicorn in prod - api.host/port/debug are unused,
# but kept here so the config validator doesn't complain)
api:
  host: "127.0.0.1"
  port: 8000
  debug: false

# My Movies sync (FreeTDS -> SQL Server, read-only)
mymovies:
  server: "192.168.2.4"
  port: "11598"
  database: "My Movies"
  username: "mymoviesapi"
  password: "changeme"
  sync_interval_hours: 24

discogs:
  token: "your_discogs_token_here"

musicbrainz:
  contact_email: "your_email@example.com"

dvd:
  # Primary rip method: dvdbackup (default) or makemkv.
  # dvdbackup uses a two-step copy+mkisofs pipeline with HandBrakeCLI pre-scan.
  # makemkv skips dvdbackup entirely and uses MakeMKV for all DVDs.
  rip_method: dvdbackup
  # When rip_method is dvdbackup, automatically re-rip with MakeMKV if the
  # disc is detected as copy-protected, dvdbackup fails, or the rip is dirty.
  # Requires MakeMKV to be installed on the ripper machine (see DEPLOYMENT.md).
  makemkv_fallback: false
